# Chọn provider mặc định: auto, openai hoặc gemini.
AI_PROVIDER=auto

# ---- DeepSeek / OpenAI-compatible ----
# Bỏ dấu # và điền đủ ba giá trị để dùng endpoint tuỳ chỉnh.
# CUSTOM_BASE_URL=https://api.inference.wandb.ai/v1
# CUSTOM_API_KEY=<YOUR_API_KEY>
# CUSTOM_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813

# ---- Gemini ----
# GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite

# Các biến dưới áp dụng cho cả request Gemini và OpenAI-compatible trong backend hiện tại.
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=1500
GEMINI_MIN_INTERVAL_MS=4500
GEMINI_ENABLE_GOOGLE_SEARCH=true
GEMINI_ENABLE_REVIEW=true
GEMINI_REVIEW_PASS_SCORE=85

# Tuỳ chọn:
# PORT=8090
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_BASE_URL=https://api.openai.com/v1
# MAX_OUTPUT_TOKENS=0

